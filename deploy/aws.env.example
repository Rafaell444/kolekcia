# Django application
DJANGO_SETTINGS_MODULE=kolekcia.settings.production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=api.koleqcia.com
CORS_ALLOWED_ORIGINS=https://www.koleqcia.com,https://koleqcia.com
CSRF_TRUSTED_ORIGINS=https://www.koleqcia.com,https://koleqcia.com
FRONTEND_URL=https://www.koleqcia.com
BACKEND_PUBLIC_URL=https://api.koleqcia.com

# Amazon RDS for PostgreSQL. URL-encode special characters in the password.
DATABASE_URL=postgresql://koleqcia_app:URL_ENCODED_PASSWORD@YOUR_RDS_ENDPOINT:5432/koleqcia
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True
DB_CONNECT_TIMEOUT=10
DB_APPLICATION_NAME=koleqcia-api
# Download the current AWS RDS global CA bundle on the server and mount it at
# this path. Use `require` only as a temporary fallback if the CA is unavailable.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/ssl/certs/global-bundle.pem
# Set True only when using a transaction-pooling proxy that requires it.
DB_DISABLE_SERVER_SIDE_CURSORS=False

# Redis/Celery (recommended on AWS for payment recovery and shared WebSockets)
REDIS_URL=rediss://YOUR_REDIS_ENDPOINT:6379/0?ssl_cert_reqs=required
CELERY_BROKER_URL=rediss://YOUR_REDIS_ENDPOINT:6379/0?ssl_cert_reqs=required
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False

# Keepz values are intentionally placeholders. Copy the real production values
# from your secret store; do not commit them.
# Enable only after credentials and the production webhook have been verified.
KEEPZ_ENABLED=False
KEEPZ_ENV=real
KEEPZ_IDENTIFIER=
KEEPZ_INTEGRATOR_ID=
KEEPZ_RECEIVER_ID=
KEEPZ_FOREIGN_RECEIVER_ID=
KEEPZ_RECEIVER_TYPE=BRANCH
KEEPZ_SPLIT_ENABLED=True
KEEPZ_VENDOR_RECEIVER_TYPE=BRANCH
KEEPZ_PUBLIC_KEY=
KEEPZ_PRIVATE_KEY=
KEEPZ_DIRECT_LINK_PROVIDER=
KEEPZ_COMMISSION_TYPE=
KEEPZ_DYNAMIC_URLS=False
# Enable only after confirming Keepz status responses include amount and currency.
KEEPZ_REQUIRE_AMOUNT_VERIFICATION=False
KEEPZ_PAYMENT_WINDOW_MINUTES=5
KEEPZ_ORDER_EXPIRY_ENABLED=False
PAYMENT_STOCK_RESERVATION_BUFFER_MINUTES=2
KEEPZ_RECONCILE_INTERVAL_SECONDS=300
KEEPZ_RECONCILE_MIN_AGE_SECONDS=300
KEEPZ_RECONCILE_MAX_AGE_HOURS=24
KEEPZ_RECONCILE_BATCH_LIMIT=25

# Email
EMAIL_BACKEND=apps.emails.backends.TrustedSMTPEmailBackend
EMAIL_HOST=smtp-relay.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_ACCOUNTS=accounts@koleqcia.com
EMAIL_FROM_ORDERS=orders@koleqcia.com
EMAIL_FROM_AUCTIONS=auctions@koleqcia.com
DEFAULT_FROM_EMAIL=info@koleqcia.com

GOOGLE_CLIENT_ID=
GOOGLE_REVIEW_URL=
GOOGLE_REVIEWS_API_URL=
GOOGLE_REVIEWS_API_TOKEN=
