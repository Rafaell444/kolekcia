# Copy to backend/.env on PythonAnywhere (Bash console: nano ~/kolekcia/backend/.env)

SECRET_KEY=generate-a-long-random-secret-key
DEBUG=False
DJANGO_SETTINGS_MODULE=kolekcia.settings.production

# SQLite on PythonAnywhere (file-based database)
# Keep this path inside your project directory.
DATABASE_URL=sqlite:////home/YOUR_USERNAME/kolekcia/backend/db.sqlite3

ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
GOOGLE_REVIEW_URL=https://g.page/r/YOUR_GOOGLE_PLACE_ID/review
# Configure these with an official Google Business Profile integration or an approved review-feed service.
GOOGLE_REVIEWS_API_URL=
GOOGLE_REVIEWS_API_TOKEN=
FRONTEND_URL=https://your-app.vercel.app
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

EMAIL_BACKEND=apps.emails.backends.TrustedSMTPEmailBackend
EMAIL_HOST=smtp-relay.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@yourdomain.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_FROM_ACCOUNTS=accounts@koleqcia.com
EMAIL_FROM_ORDERS=orders@koleqcia.com
EMAIL_FROM_AUCTIONS=auctions@koleqcia.com
DEFAULT_FROM_EMAIL=info@koleqcia.com
